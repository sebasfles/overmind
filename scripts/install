#!/usr/bin/env bash
# install: link the global roles and the skills into ~/.claude, and everything in bin/ into ~/bin. Idempotent.
# bin/ holds what Sebastian types; scripts/ holds what agents and the repo run (this file, resume-project, lint-method).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p ~/.claude/agents ~/.claude/skills ~/bin

link() { # link <target> <linkpath>
  if [[ -L "$2" ]]; then
    [[ "$(readlink -f "$2")" == "$(readlink -f "$1")" ]] && { echo "ok      $2"; return; }
    rm "$2"
  elif [[ -e "$2" ]]; then
    echo "SKIP    $2 exists and is not a symlink" >&2; return
  fi
  ln -s "$1" "$2" && echo "linked  $2 -> $1"
}

for a in "$root"/agents/*.md; do link "$a" ~/.claude/agents/"$(basename "$a")"; done
for s in "$root"/skills/*/; do s="${s%/}"; link "$s" ~/.claude/skills/"$(basename "$s")"; done
for b in "$root"/bin/*; do link "$b" ~/bin/"$(basename "$b")"; done

# tmux recycle binding: prefix + R respawns the current pane's original command, giving a fresh agent session.
tmux_conf="$HOME/.tmux.conf"
if [[ -f "$tmux_conf" ]] && grep -qE '^bind(-key)? +R\b' "$tmux_conf"; then
  echo "ok      tmux bind R already in $tmux_conf"
else
  printf '\n# overmind: recycle the current pane (fresh agent session, same command)\nbind R confirm-before -p "recycle pane? (y/n)" "respawn-pane -k"\n' >> "$tmux_conf"
  echo "added   tmux bind R to $tmux_conf"
fi
tmux source-file "$tmux_conf" 2>/dev/null || true

case ":$PATH:" in *":$HOME/bin:"*) ;; *) echo "note: add ~/bin to PATH" ;; esac
echo "done. Cockpit agents (overmind, om-events, om-config) stay project-scoped in $root/.claude/agents."
