#!/usr/bin/env bash
# install: link the global roles and the skills into ~/.claude, and everything in bin/ into ~/bin. Idempotent.
# bin/ holds what Sebastian types; scripts/ holds what agents and the repo run (this file, resume-project, lint-method).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p ~/.claude/agents ~/.claude/skills ~/bin

link() { # link <target> <linkpath>
  if [[ -L "$2" ]]; then
    [[ "$(readlink -f "$2")" == "$(readlink -f "$1")" ]] && { echo "ok      $2"; return; }
    rm "$2"
  elif [[ -e "$2" ]]; then
    echo "SKIP    $2 exists and is not a symlink" >&2; return
  fi
  ln -s "$1" "$2" && echo "linked  $2 -> $1"
}

for a in "$root"/agents/*.md; do link "$a" ~/.claude/agents/"$(basename "$a")"; done
for s in "$root"/skills/*/; do s="${s%/}"; link "$s" ~/.claude/skills/"$(basename "$s")"; done
for b in "$root"/bin/*; do link "$b" ~/bin/"$(basename "$b")"; done

# tmux recycle binding: prefix + R respawns the current pane's original command, giving a fresh agent session.
tmux_conf="$HOME/.tmux.conf"
if [[ -f "$tmux_conf" ]] && grep -qE '^bind(-key)? +R\b' "$tmux_conf"; then
  echo "ok      tmux bind R already in $tmux_conf"
else
  printf '\n# overmind: recycle the current pane (fresh agent session, same command)\nbind R confirm-before -p "recycle pane? (y/n)" "respawn-pane -k"\n' >> "$tmux_conf"
  echo "added   tmux bind R to $tmux_conf"
fi
tmux source-file "$tmux_conf" 2>/dev/null || true

# Permission allow rules the method needs so agent sessions can launch and manage each other.
# Report only; granting permissions is Sebastian's act, never a script's.
python3 - <<'PY'
import json, os
required = [
    "Bash(claude --agent *)", "Bash(claude --bg *)", "Bash(claude attach *)",
    "Bash(claude -r *)", "Bash(claude --resume *)", "Bash(claude stop *)",
    "Bash(claude agents *)", "Bash(tmux new-window *)", "Bash(tmux new-session *)",
    "Bash(tmux send-keys *)", "Bash(tmux split-window *)", "Bash(tmux respawn-pane *)",
    "Bash(tmux select-window *)", "Bash(tmux list-windows *)", "Bash(tmux list-panes *)",
    "Bash(tmux has-session *)", "Bash(tmux kill-window *)",
    "SendMessage",
]
path = os.path.expanduser("~/.claude/settings.json")
try:
    allow = json.load(open(path)).get("permissions", {}).get("allow", [])
except (FileNotFoundError, json.JSONDecodeError):
    allow = []
missing = [r for r in required if r not in allow]
if missing:
    print("MISSING permission allow rules in ~/.claude/settings.json (agents cannot launch each other without them).")
    print('Paste into "permissions": { "allow": [ ... ] }:')
    print(json.dumps(missing, indent=2))
else:
    print("ok      permission allow rules present in ~/.claude/settings.json")
try:
    auto_allow = json.load(open(path)).get("autoMode", {}).get("allow", [])
except (FileNotFoundError, json.JSONDecodeError):
    auto_allow = []
entry = ("Overmind sessions: launching `claude --bg --allow-dangerously-skip-permissions --agent om-reviewer`, "
         "`om-developer` or `om-pr-reviewer` inside a project's `.workspaces/` directory is allowed. "
         "These are Sebastian's own per-task review and developer sessions of the overmind method, "
         "isolated in git worktrees; the flag is how the method runs them.")
if not any(a.startswith("Overmind sessions:") for a in auto_allow):
    print("MISSING autoMode.allow entry in ~/.claude/settings.json (since Claude Code 2.1.281 the classifier's Create Unsafe Agents rule blocks the launch even with the allow rules).")
    print('Paste into "autoMode": { "allow": [ ... ] }, keeping "$defaults" first; sessions started before the edit do not see it:')
    print(json.dumps(["$defaults", entry], indent=2))
else:
    print("ok      autoMode.allow entry for overmind sessions present in ~/.claude/settings.json")
PY

# Tools the skills call from Bash: jq (clean-task, delegate-task and next-phase parse
# 'claude agents --all --json') and gh (check-task, publish-task). Report, do not install.
for tool in jq gh; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "ok      $tool present"
  else
    echo "MISSING $tool: install it; the skills that list sessions or PRs from Bash need it."
  fi
done

# om-reviewer and om-developer run with permissionMode bypassPermissions, which needs the
# disclaimer accepted once per machine; without it, --bg launches fail non-interactively.
# Functional check (the persisted key is not greppable in current versions): try one throwaway
# --bg bypass launch and clean it up. Accepting the disclaimer stays Sebastian's interactive act.
if command -v claude >/dev/null 2>&1; then
  bg_out="$(claude --bg --dangerously-skip-permissions --model haiku "say ok and nothing else" 2>&1 || true)"
  bg_id="$(printf '%s' "$bg_out" | grep -oE 'backgrounded · [a-z0-9]+' | awk '{print $3}')"
  if [[ -n "$bg_id" ]]; then
    claude stop "$bg_id" >/dev/null 2>&1 || true
    claude rm "$bg_id" >/dev/null 2>&1 || true
    echo "ok      bypass-permissions launches work"
  else
    echo "MISSING bypass-permissions acceptance."
    echo "        Run 'claude --dangerously-skip-permissions' once in a terminal, accept the bypass warning (not just the folder trust dialog), exit."
    echo "        Without it, om-reviewer and om-developer cannot start bypassed and --bg launches fail."
  fi
fi

case ":$PATH:" in *":$HOME/bin:"*) ;; *) echo "note: add ~/bin to PATH" ;; esac
echo "done. Cockpit agents (overmind, om-events, om-config) stay project-scoped in $root/.claude/agents."
