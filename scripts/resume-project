#!/usr/bin/env bash
# resume-project <name>
# Opens a registered project in a new Windows Terminal tab (WSL), attached to its tmux session,
# creating the session with the om-manager in window 0 (cwd = project root) if it does not exist.
set -euo pipefail

name="${1:-}"
[[ -n "$name" ]] || { echo "usage: resume-project <name>" >&2; exit 2; }

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
registry="$repo_root/portfolio/projects.yaml"
[[ -f "$registry" ]] || { echo "registry not found: $registry" >&2; exit 1; }

# Minimal YAML lookup over "- name: X" blocks with flat keys (root, tmux).
root="$(awk -v n="$name" '
  /^  - name:/ { cur=$3 }
  cur==n && /^    root:/ { print $2; exit }
' "$registry")"
tmux_name="$(awk -v n="$name" '
  /^  - name:/ { cur=$3 }
  cur==n && /^    tmux:/ { print $2; exit }
' "$registry")"
[[ -n "$root" ]] || { echo "project not registered: $name" >&2; exit 1; }
tmux_name="${tmux_name:-$name}"
[[ -d "$root" ]] || { echo "root does not exist: $root" >&2; exit 1; }

distro="${WSL_DISTRO_NAME:-Ubuntu}"

if ! tmux has-session -t "$tmux_name" 2>/dev/null; then
  tmux new-session -d -s "$tmux_name" -c "$root" -n om-manager \
    "claude --agent om-manager -n om-${name}-manager"
fi

if command -v wt.exe >/dev/null 2>&1; then
  wt.exe -w 0 new-tab --title "$name" \
    wsl.exe -d "$distro" --cd "$root" -- tmux attach -t "$tmux_name"
else
  if [[ -n "${TMUX:-}" ]]; then tmux switch-client -t "$tmux_name"; else tmux attach -t "$tmux_name"; fi
fi
