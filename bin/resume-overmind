#!/usr/bin/env bash
# resume-overmind
# Ensures the overmind tmux session has its three Claude sessions
# (window "overmind": overmind | om-events; window "config": om-config), creating only what is missing,
# then brings you there in place: switches if you are already in tmux, replaces the current terminal otherwise.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
S=overmind

if ! tmux has-session -t "$S" 2>/dev/null; then
  tmux new-session -d -s "$S" -c "$root" -n overmind "claude --agent overmind -n overmind"
fi

next_index() { echo $(( $(tmux list-windows -t "$S" -F '#I' | sort -n | tail -1) + 1 )); }

if ! tmux list-windows -t "$S" -F '#W' | grep -qx overmind; then
  tmux new-window -t "$S:$(next_index)" -n overmind -c "$root" "claude --agent overmind -n overmind"
fi

if [[ "$(tmux list-panes -t "$S:overmind" -F x | wc -l)" -lt 2 ]]; then
  tmux split-window -h -t "$S:overmind" -c "$root" "claude --agent om-events -n om-events"
  tmux select-pane -t "$S:overmind.0"
fi

if ! tmux list-windows -t "$S" -F '#W' | grep -qx config; then
  tmux new-window -t "$S:$(next_index)" -n config -c "$root" "claude --agent om-config -n om-config"
fi

tmux select-window -t "$S:overmind"

if [[ -n "${TMUX:-}" ]]; then
  [[ "$(tmux display-message -p '#S')" == "$S" ]] || tmux switch-client -t "$S"
else
  exec tmux attach -t "$S"
fi
