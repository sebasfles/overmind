#!/usr/bin/env bash
# resume-overmind
# Opens the overmind tmux session (window "overmind": overmind | overmind-events; window "config": overmind-config)
# in a new Windows Terminal tab, creating what does not exist.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
distro="${WSL_DISTRO_NAME:-Ubuntu}"

if ! tmux has-session -t overmind 2>/dev/null; then
  tmux new-session -d -s overmind -c "$root" -n overmind "claude --agent overmind -n overmind"
  tmux split-window -h -t overmind:overmind -c "$root" "claude --agent om-events -n overmind-events"
  tmux select-pane -t overmind:overmind.0
  tmux new-window -t overmind -n config -c "$root" "claude --agent om-config -n overmind-config"
  tmux select-window -t overmind:overmind
fi

if command -v wt.exe >/dev/null 2>&1; then
  wt.exe -w 0 new-tab --title overmind wsl.exe -d "$distro" --cd "$root" -- tmux attach -t overmind
else
  if [[ -n "${TMUX:-}" ]]; then tmux switch-client -t overmind; else tmux attach -t overmind; fi
fi
